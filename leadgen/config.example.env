# Copy to config.env (git-ignored) and fill in. Never commit config.env.

# Who the email is from. Use a separate outreach domain (e.g. getyourbrand.com)
# so cold-email complaints can't hurt your main domain's reputation.
FROM_NAME=Your Name
FROM_EMAIL=you@your-outreach-domain.com
REPLY_TO=
FROM_PHONE=(555) 555-5555

# Required by US law (CAN-SPAM): your business name and a real postal address.
COMPANY_NAME=Your Company LLC
COMPANY_ADDRESS=123 Main St, Panama City, FL 32401

# SMTP login. Google Workspace: smtp.gmail.com, port 587, and an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@your-outreach-domain.com
SMTP_PASSWORD=
